# Copy this file to .env and fill in your values

# ── Platform UPI (used for subscription renewal & additional product payments) ──
VITE_PLATFORM_UPI_ID=yourname@paytm
VITE_PLATFORM_UPI_NAME=Your Business Name

# ── Backend API ─────────────────────────────────────────────────────────────────
# Set to false when you are ready to connect a real backend
VITE_USE_MOCK_API=true
# Base URL for the real backend REST API (ignored when VITE_USE_MOCK_API=true)
VITE_API_BASE_URL=https://api.yourbackend.com

# ── Error Reporting via EmailJS ──────────────────────────────────────────────────
# Create a free account at https://www.emailjs.com
# Add a service (Gmail / SMTP) and an email template with these variables:
#   {{to_email}}, {{app_name}}, {{error_message}}, {{error_stack}},
#   {{error_context}}, {{page_url}}, {{user_agent}}, {{timestamp}}
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
# Recipient address for error reports
VITE_ERROR_REPORT_EMAIL=bankai.tech12@gmail.com

# ── App metadata ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=Popna Billing
