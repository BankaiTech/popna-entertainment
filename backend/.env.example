# Copy to .env and fill in. NEVER commit .env to GitHub.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=api.lcodesk.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.lcodesk.in
# Your frontend URL(s), comma-separated
CORS_ALLOWED_ORIGINS=https://app.lcodesk.in
# Turn on only after HTTPS works for a few days (31536000 = 1 year)
SECURE_HSTS_SECONDS=0

# ── Database (docker-compose fills POSTGRES_HOST=db) ─────────────────────────
POSTGRES_DB=lcodesk
POSTGRES_USER=lcodesk
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_HOST=db
# AWS RDS: POSTGRES_HOST=<your-rds-endpoint>.ap-south-1.rds.amazonaws.com
# Encrypt the DB connection. For RDS use verify-full + the RDS certificate bundle (see DEPLOY_CHECKLIST.md)
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=

# ── Domain for HTTPS (Caddy gets the certificate automatically) ──────────────
API_DOMAIN=api.lcodesk.in

# ── SMS via ping4sms (sent ONLY to customers) ───────────────────────────────
# console = print SMS in logs (testing). http = really send.
SMS_BACKEND=console
# ping4sms URL with placeholders (keep exactly as below; values are filled in per SMS):
SMS_HTTP_URL=https://site.ping4sms.com/api/smsapi?key={api_key}&route={route}&sender={sender}&number={mobile}&sms={message}&templateid={template_id}
SMS_HTTP_METHOD=GET
# Your ping4sms API key. Only ever here, never in code or chat.
SMS_API_KEY=
# Your DLT-approved 6-letter sender ID (header), and route number from ping4sms
SMS_SENDER_ID=
SMS_ROUTE=2
SMS_DLT_ENTITY_ID=
# Leave empty if the gateway wants 10 digits; set 91 if it wants 91XXXXXXXXXX
SMS_MOBILE_PREFIX=
# Optional: a word that appears in a successful API response
SMS_SUCCESS_KEYWORD=
# Approved customer templates (English / Tamil)
SMS_TPL_CUSTOMER_EN=1607100000000376221
SMS_TPL_CUSTOMER_TA=1607100000000376222
# Extra URL text ping4sms needs for Tamil (Unicode) SMS. Ask ping4sms support, e.g. &unicode=1
SMS_UNICODE_PARAMS=
# Only if your approved wording differs. Use {name} {body} {org} and \n for new lines.
# SMS_TEXT_CUSTOMER_EN=Dear Customer {name},\n{body}\nThank you for your continued support.\nRegards,\n{org}\nPING4SMS

# ── Scheduler times (IST, 24h) ───────────────────────────────────────────────
SCHEDULE_DUE_REMINDERS_AT=09:00
SCHEDULE_GENERATE_BILLS_AT=06:00
SCHEDULE_PURGE_LOCATIONS_AT=03:00
BILL_GENERATION_DAY=1

# ── Tracking ─────────────────────────────────────────────────────────────────
LOCATION_RETENTION_DAYS=90
