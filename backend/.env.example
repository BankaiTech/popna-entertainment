# Copy to .env and fill in. NEVER commit .env to GitHub.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=api.lcodesk.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.lcodesk.in
# Django admin path (hard to guess). Leave empty to switch the admin off.
DJANGO_ADMIN_URL=
# Your frontend URL(s), comma-separated
CORS_ALLOWED_ORIGINS=https://app.lcodesk.in
# Turn on only after HTTPS works for a few days (31536000 = 1 year)
SECURE_HSTS_SECONDS=31536000

# ── Database (docker-compose fills POSTGRES_HOST=db) ─────────────────────────
POSTGRES_DB=lcodesk
POSTGRES_USER=lcodesk
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_HOST=db
# AWS RDS: POSTGRES_HOST=<your-rds-endpoint>.ap-south-1.rds.amazonaws.com
# Encrypt the DB connection. For RDS use verify-full + the RDS certificate bundle (see DEPLOY_CHECKLIST.md)
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=

# ── Domain for HTTPS (Caddy gets the certificate automatically) ──────────────
API_DOMAIN=api.lcodesk.in

# ── SMS via ping4sms (sent ONLY to customers) ───────────────────────────────
# console = print SMS in logs (testing). http = really send.
SMS_BACKEND=console
# ping4sms URL with placeholders (keep exactly as below; values are filled in per SMS):
SMS_HTTP_URL=https://site.ping4sms.com/api/smsapi?key={api_key}&route={route}&sender={sender}&number={mobile}&sms={message}&templateid={template_id}
SMS_HTTP_METHOD=GET
# Your ping4sms API key. Only ever here, never in code or chat.
SMS_API_KEY=
# Your DLT-approved 6-letter sender ID (header), and route number from ping4sms
SMS_SENDER_ID=
SMS_ROUTE=2
SMS_DLT_ENTITY_ID=
# Leave empty if the gateway wants 10 digits; set 91 if it wants 91XXXXXXXXXX
SMS_MOBILE_PREFIX=
# Optional: a word that appears in a successful API response
SMS_SUCCESS_KEYWORD=
# Approved DLT template ids. Built in already; set only to change one (see docs/DLT_SMS_TEMPLATES.md).
# SMS_TPL_RECEIPT_EN=1607100000000376221
# SMS_TPL_REMINDER_EN=1607100000000376221
# SMS_TPL_RECEIPT_TA=1677100000000399500
# SMS_TPL_REMINDER_TA=1677100000000399495
# Extra URL text ping4sms needs for Tamil (Unicode) SMS. Ask ping4sms support, e.g. &unicode=1
SMS_UNICODE_PARAMS=
# Only if a new template keeps the same 3 variables. Use {name} {body} {org} and \n for new lines.
# SMS_TEXT_RECEIPT_EN=Dear Customer {name},\n{body}\nThank you for your continued support.\nRegards,\n{org}\nPING4SMS
# Internet customers' SMS: off until a template for them is approved.
SMS_INTERNET_ENABLED=false
# All customer SMS go in this language (no per-customer choice for now). Empty = customer's / operator's choice.
SMS_ONLY_LANGUAGE=ta

# ── Scheduler times (IST, 24h) ───────────────────────────────────────────────
SCHEDULE_DUE_REMINDERS_AT=09:00
SCHEDULE_GENERATE_BILLS_AT=06:00
SCHEDULE_PURGE_LOCATIONS_AT=03:00
BILL_GENERATION_DAY=1

# ── Tracking ─────────────────────────────────────────────────────────────────
LOCATION_RETENTION_DAYS=90

# Public sign-up form (/api/signup-requests): max submissions per IP
SIGNUP_RATE=5/hour
# Number of reverse proxies in front of Django (Caddy = 1). Used to find the real client IP for rate limits.
# 1 = Caddy only. If api.lcodesk.in is proxied by Cloudflare (orange cloud), use 2 so login limits
# count each real visitor, not the Cloudflare server.
DRF_NUM_PROXIES=1

# Where operators pay LCO Desk (SMS packs, renewals). The app opens the chosen UPI app with this ID.
# These defaults are already built in; set them only to change an ID.
# PLATFORM_UPI_PAYEE_NAME=LCO Desk
# PLATFORM_UPI_GPAY=msv31bieber@oksbi
# PLATFORM_UPI_PHONEPE=8072787387@ybl
# PLATFORM_UPI_PAYTM=8072787387@ptyes
# PLATFORM_UPI_BHIM=vicky2135@upi

# Cashfree Payment Gateway ("Pay online" button). Leave empty to show only the UPI QR.
# Keys: Cashfree dashboard > Developers > API Keys. Use TEST keys with CASHFREE_ENV=sandbox first.
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=sandbox
# CASHFREE_API_VERSION=2025-01-01
# CASHFREE_RETURN_URL=https://lcodesk.in/admin/settings?tab=plan
# CASHFREE_NOTIFY_URL=https://api.lcodesk.in/api/payments/cashfree/webhook
# Sandbox only: test operator ids (comma separated) that see "Pay online". Real operators never see sandbox.
# CASHFREE_SANDBOX_ORG_IDS=
