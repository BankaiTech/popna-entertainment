# Copy to .env and fill in. NEVER commit .env to GitHub.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=api.lcodesk.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.lcodesk.in
# Your frontend URL(s), comma-separated
CORS_ALLOWED_ORIGINS=https://app.lcodesk.in
# Turn on only after HTTPS works for a few days (31536000 = 1 year)
SECURE_HSTS_SECONDS=0

# ── Database (docker-compose fills POSTGRES_HOST=db) ─────────────────────────
POSTGRES_DB=lcodesk
POSTGRES_USER=lcodesk
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_HOST=db

# ── Domain for HTTPS (Caddy gets the certificate automatically) ──────────────
API_DOMAIN=api.lcodesk.in

# ── SMS via ping4sms ─────────────────────────────────────────────────────────
# console = print SMS in logs (testing). http = really send.
SMS_BACKEND=console
# Copy the "Send SMS" API URL from your ping4sms panel and replace the values with placeholders:
#   {api_key} {sender} {mobile} {message} {template_id} {entity_id} {route}
# Example SHAPE only (use the exact URL from your panel):
# SMS_HTTP_URL=https://<ping4sms-api-host>/<path>?key={api_key}&sender={sender}&number={mobile}&sms={message}&templateid={template_id}
SMS_HTTP_URL=
SMS_HTTP_METHOD=GET
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ROUTE=
SMS_DLT_ENTITY_ID=
# Leave empty if the gateway wants 10 digits; set 91 if it wants 91XXXXXXXXXX
SMS_MOBILE_PREFIX=
# Optional: a word that appears in a successful API response (check ping4sms docs)
SMS_SUCCESS_KEYWORD=
# DLT template IDs (from your DLT portal) for each message type
SMS_TPL_PAYMENT_RECEIPT=
SMS_TPL_OWNER_PAYMENT_ALERT=
SMS_TPL_DUE_REMINDER=
SMS_TPL_OWNER_DAILY_SUMMARY=

# ── Scheduler times (IST, 24h) ───────────────────────────────────────────────
SCHEDULE_DUE_REMINDERS_AT=09:00
SCHEDULE_OWNER_SUMMARY_AT=21:00
SCHEDULE_GENERATE_BILLS_AT=06:00
SCHEDULE_PURGE_LOCATIONS_AT=03:00
BILL_GENERATION_DAY=1

# ── Tracking ─────────────────────────────────────────────────────────────────
LOCATION_RETENTION_DAYS=90
